# Copy to .env next to docker-compose.yml.
# Everything here is optional: the container starts without it and the web
# interface on http://<host>:8787 walks you through the setup, storing what you
# enter in /config/settings.json.

# Sonarr (series)
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Radarr (movies) — optional
RADARR_ENABLED=false
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# Observe-only until the decisions look right
DRY_RUN=true

# Sign-in for the web interface. Set both, or the interface stays open to
# anyone who can reach the port.
WEB_USERNAME=
WEB_PASSWORD=

# Discord webhook (or any other URL, which receives plain JSON)
WEBHOOK_URL=

TZ=Europe/Berlin
